{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yuriyapostol.github.io/knot-engine/v1/schema/2d.schema.json",
  "$ref": "#/$defs/geometry2d",
  "$defs": {
    "geometry2d": {
      "type": "object",
      "properties": {
        "coordinateSystem": {
          "type": "object",
          "properties": {
            "xAxis": {
              "const": "right"
            },
            "yAxis": {
              "const": "up"
            },
            "scale": {
              "$ref": "#/$defs/scale"
            }
          },
          "required": [
            "xAxis",
            "yAxis",
            "scale"
          ],
          "additionalProperties": false
        },
        "elements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/curve2"
          },
          "minItems": 1,
          "maxItems": 256
        },
        "crossings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/crossingPassage"
          }
        }
      },
      "required": [
        "coordinateSystem",
        "elements"
      ],
      "additionalProperties": false
    },
    "scale": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "relative"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "physical"
            },
            "metersPerUnit": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "kind",
            "metersPerUnit"
          ],
          "additionalProperties": false
        }
      ]
    },
    "curve2": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "curve"
        },
        "object": {
          "type": "string",
          "minLength": 1
        },
        "closed": {
          "type": "boolean"
        },
        "interpolation": {
          "$ref": "#/$defs/interpolation"
        },
        "points": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/point2"
          },
          "minItems": 2,
          "maxItems": 4096
        }
      },
      "required": [
        "id",
        "type",
        "closed",
        "interpolation",
        "points"
      ],
      "additionalProperties": false
    },
    "interpolation": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "polyline"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "catmull-rom"
            },
            "parameterization": {
              "const": "uniform"
            },
            "tension": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "type",
            "parameterization",
            "tension"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "catmull-rom"
            },
            "parameterization": {
              "enum": [
                "centripetal",
                "chordal"
              ]
            }
          },
          "required": [
            "type",
            "parameterization"
          ],
          "additionalProperties": false
        }
      ]
    },
    "point2": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number"
      }
    },
    "crossingPassage": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "element": {
              "type": "string",
              "minLength": 1
            },
            "underElement": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "id",
            "element",
            "underElement"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "element": {
              "type": "string",
              "minLength": 1
            },
            "overElement": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "id",
            "element",
            "overElement"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
