{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yuriyapostol.github.io/knot-engine/v1/schema/catalog.schema.json",
  "$ref": "#/$defs/catalog",
  "$defs": {
    "catalog": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "homepage": {
          "type": "string",
          "minLength": 1
        },
        "edition": {
          "type": "string",
          "minLength": 1
        },
        "identifierRules": {
          "type": "object",
          "properties": {
            "caseSensitive": {
              "type": "boolean"
            },
            "pattern": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "names": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/name"
          },
          "maxItems": 128
        },
        "descriptions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/name"
          },
          "maxItems": 128
        }
      },
      "required": [
        "id",
        "name",
        "description"
      ],
      "additionalProperties": false
    },
    "name": {
      "type": "object",
      "properties": {
        "language": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "language",
        "value"
      ],
      "additionalProperties": false
    }
  }
}
