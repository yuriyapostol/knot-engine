{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yuriyapostol.github.io/knot-engine/v1/schema/representation.schema.json",
  "$ref": "#/$defs/representation",
  "$defs": {
    "representation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "$ref": "#/$defs/target"
        },
        "data": {},
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceUse"
          },
          "maxItems": 256
        },
        "contributions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/contribution"
          },
          "maxItems": 1024
        },
        "names": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/name"
          },
          "minItems": 0,
          "maxItems": 128
        },
        "descriptions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/name"
          },
          "minItems": 0,
          "maxItems": 128
        }
      },
      "required": [
        "id",
        "type",
        "data"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "https://yuriyapostol.github.io/knot-engine/v1/representation-types/grid-diagram"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/grid"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "https://yuriyapostol.github.io/knot-engine/v1/representation-types/mosaic-diagram"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/mosaic"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "https://yuriyapostol.github.io/knot-engine/v1/representation-types/pd-code"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/pd"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "https://yuriyapostol.github.io/knot-engine/v1/representation-types/dt-code"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/dt"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "https://yuriyapostol.github.io/knot-engine/v1/representation-types/2d"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/geometry2d"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "https://yuriyapostol.github.io/knot-engine/v1/representation-types/3d"
              }
            }
          },
          "then": {
            "properties": {
              "data": {
                "$ref": "#/$defs/geometry3d"
              }
            }
          }
        }
      ]
    },
    "target": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "subject"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "construction"
            },
            "construction": {
              "$ref": "#/$defs/reference"
            }
          },
          "required": [
            "kind",
            "construction"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "enum": [
                "state",
                "object"
              ]
            },
            "construction": {
              "$ref": "#/$defs/reference"
            },
            "id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "construction",
            "id"
          ],
          "additionalProperties": false
        }
      ]
    },
    "reference": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "id"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "ref": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "ref"
          ],
          "additionalProperties": false
        }
      ]
    },
    "sourceUse": {
      "oneOf": [
        {
          "$ref": "#/$defs/source"
        },
        {
          "$ref": "#/$defs/sourceReference"
        }
      ]
    },
    "source": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "url": {
          "type": "string",
          "pattern": "^https?://[^\\s]+$"
        },
        "authors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceAuthor"
          },
          "maxItems": 128,
          "minItems": 1
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "license": {
          "$ref": "#/$defs/license"
        },
        "locator": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "accessed": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [],
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "title"
          ]
        },
        {
          "required": [
            "url"
          ]
        }
      ]
    },
    "sourceAuthor": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "email": {
          "type": "string",
          "pattern": "^[^@\\s]+@[^@\\s]+$"
        },
        "url": {
          "type": "string",
          "pattern": "^https?://[^\\s]+$"
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "license": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "url": {
          "type": "string",
          "pattern": "^https?://[^\\s]+$"
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "sourceReference": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "locator": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "accessed": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [],
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "id"
          ],
          "not": {
            "required": [
              "ref"
            ]
          }
        },
        {
          "required": [
            "ref"
          ],
          "not": {
            "required": [
              "id"
            ]
          }
        }
      ]
    },
    "contribution": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "email": {
          "type": "string",
          "pattern": "^[^@\\s]+@[^@\\s]+$"
        },
        "url": {
          "type": "string",
          "pattern": "^https?://[^\\s]+$"
        },
        "roles": {
          "type": "array",
          "items": {
            "enum": [
              "creation",
              "import",
              "conversion",
              "editing",
              "validation"
            ]
          },
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "name": {
      "type": "object",
      "properties": {
        "language": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "language",
        "value"
      ],
      "additionalProperties": false
    },
    "grid": {
      "oneOf": [
        {
          "$ref": "#/$defs/gridXO"
        },
        {
          "$ref": "#/$defs/gridVertexPairs"
        }
      ]
    },
    "gridXO": {
      "type": "object",
      "properties": {
        "encoding": {
          "const": "xo"
        },
        "size": {
          "type": "integer",
          "minimum": 2,
          "maximum": 512
        },
        "x": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 2,
          "maxItems": 512
        },
        "o": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 2,
          "maxItems": 512
        }
      },
      "required": [
        "encoding",
        "size",
        "x",
        "o"
      ],
      "additionalProperties": false
    },
    "gridVertexPairs": {
      "type": "object",
      "properties": {
        "encoding": {
          "const": "vertex-pairs"
        },
        "size": {
          "type": "integer",
          "minimum": 2,
          "maximum": 512
        },
        "vertices": {
          "type": "array",
          "minItems": 4,
          "maxItems": 1024,
          "uniqueItems": true,
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "integer",
                "minimum": 0
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          }
        }
      },
      "required": [
        "encoding",
        "size",
        "vertices"
      ],
      "additionalProperties": false
    },
    "mosaic": {
      "type": "object",
      "properties": {
        "tileSet": {
          "const": "https://yuriyapostol.github.io/knot-engine/v1/tile-sets/lomonaco-kauffman-11"
        },
        "tiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10
            }
          }
        }
      },
      "required": [
        "tileSet",
        "tiles"
      ],
      "additionalProperties": false
    },
    "pd": {
      "type": "object",
      "properties": {
        "convention": {
          "const": "https://yuriyapostol.github.io/knot-engine/v1/conventions/pd-ccw-under-first"
        },
        "crossings": {
          "type": "array",
          "maxItems": 16384,
          "items": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "minItems": 4,
            "maxItems": 4
          }
        },
        "unlinkedComponents": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16384
        }
      },
      "required": [
        "convention",
        "crossings"
      ],
      "additionalProperties": false
    },
    "dt": {
      "type": "object",
      "properties": {
        "convention": {
          "const": "https://yuriyapostol.github.io/knot-engine/v1/conventions/dt-signed-even"
        },
        "code": {
          "oneOf": [
            {
              "type": "array",
              "maxItems": 512,
              "items": {
                "type": "integer",
                "multipleOf": 2,
                "minimum": -1024,
                "maximum": 1024,
                "not": {
                  "const": 0
                }
              }
            },
            {
              "type": "array",
              "minItems": 1,
              "maxItems": 512,
              "items": {
                "type": "array",
                "maxItems": 512,
                "items": {
                  "type": "integer",
                  "multipleOf": 2,
                  "minimum": -1024,
                  "maximum": 1024,
                  "not": {
                    "const": 0
                  }
                }
              }
            }
          ]
        }
      },
      "required": [
        "convention",
        "code"
      ],
      "additionalProperties": false
    },
    "geometry2d": {
      "type": "object",
      "properties": {
        "coordinateSystem": {
          "type": "object",
          "properties": {
            "xAxis": {
              "const": "right"
            },
            "yAxis": {
              "const": "up"
            },
            "scale": {
              "$ref": "#/$defs/scale"
            }
          },
          "required": [
            "xAxis",
            "yAxis",
            "scale"
          ],
          "additionalProperties": false
        },
        "elements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/curve2"
          },
          "minItems": 1,
          "maxItems": 256
        },
        "crossings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/crossingPassage"
          }
        }
      },
      "required": [
        "coordinateSystem",
        "elements"
      ],
      "additionalProperties": false
    },
    "scale": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "relative"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "physical"
            },
            "metersPerUnit": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "kind",
            "metersPerUnit"
          ],
          "additionalProperties": false
        }
      ]
    },
    "curve2": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "curve"
        },
        "object": {
          "type": "string",
          "minLength": 1
        },
        "closed": {
          "type": "boolean"
        },
        "interpolation": {
          "$ref": "#/$defs/interpolation"
        },
        "points": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/point2"
          },
          "minItems": 2,
          "maxItems": 4096
        }
      },
      "required": [
        "id",
        "type",
        "closed",
        "interpolation",
        "points"
      ],
      "additionalProperties": false
    },
    "interpolation": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "polyline"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "catmull-rom"
            },
            "parameterization": {
              "const": "uniform"
            },
            "tension": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "type",
            "parameterization",
            "tension"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "catmull-rom"
            },
            "parameterization": {
              "enum": [
                "centripetal",
                "chordal"
              ]
            }
          },
          "required": [
            "type",
            "parameterization"
          ],
          "additionalProperties": false
        }
      ]
    },
    "point2": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "number"
      }
    },
    "crossingPassage": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "element": {
              "type": "string",
              "minLength": 1
            },
            "underElement": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "id",
            "element",
            "underElement"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "element": {
              "type": "string",
              "minLength": 1
            },
            "overElement": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "id",
            "element",
            "overElement"
          ],
          "additionalProperties": false
        }
      ]
    },
    "geometry3d": {
      "type": "object",
      "properties": {
        "coordinateSystem": {
          "type": "object",
          "properties": {
            "handedness": {
              "const": "right"
            },
            "upAxis": {
              "const": "y"
            },
            "scale": {
              "$ref": "#/$defs/scale"
            }
          },
          "required": [
            "handedness",
            "upAxis",
            "scale"
          ],
          "additionalProperties": false
        },
        "elements": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/curve3"
              },
              {
                "$ref": "#/$defs/mesh3"
              }
            ]
          },
          "minItems": 1,
          "maxItems": 256
        }
      },
      "required": [
        "coordinateSystem",
        "elements"
      ],
      "additionalProperties": false
    },
    "curve3": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "curve"
        },
        "object": {
          "type": "string",
          "minLength": 1
        },
        "closed": {
          "type": "boolean"
        },
        "interpolation": {
          "$ref": "#/$defs/interpolation"
        },
        "points": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/point3"
          },
          "minItems": 2,
          "maxItems": 4096
        }
      },
      "required": [
        "id",
        "type",
        "closed",
        "interpolation",
        "points"
      ],
      "additionalProperties": false
    },
    "point3": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "mesh3": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "mesh"
        },
        "object": {
          "type": "string",
          "minLength": 1
        },
        "vertices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/point3"
          },
          "minItems": 3
        },
        "faces": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "type",
        "vertices",
        "faces"
      ],
      "additionalProperties": false
    }
  }
}
