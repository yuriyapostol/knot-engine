{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yuriyapostol.github.io/knot-engine/v1/schema/construction.schema.json",
  "$ref": "#/$defs/construction",
  "$defs": {
    "construction": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "objects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/object"
          },
          "minItems": 1,
          "maxItems": 256
        },
        "states": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/state"
          },
          "minItems": 0,
          "maxItems": 256
        },
        "names": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/name"
          },
          "maxItems": 128
        },
        "descriptions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/name"
          },
          "maxItems": 128
        }
      },
      "required": [
        "id",
        "objects"
      ],
      "additionalProperties": false
    },
    "object": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "type"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "https://yuriyapostol.github.io/knot-engine/v1/object-types/rope"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/rope"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "https://yuriyapostol.github.io/knot-engine/v1/object-types/support",
                  "https://yuriyapostol.github.io/knot-engine/v1/object-types/carabiner"
                ]
              }
            }
          },
          "then": {
            "$ref": "#/$defs/equipment"
          }
        }
      ]
    },
    "rope": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "topology": {
          "enum": [
            "open",
            "closed"
          ]
        },
        "ends": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 2
        },
        "length": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "diameter": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "id",
        "type",
        "topology",
        "ends"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "topology": {
                "const": "open"
              }
            }
          },
          "then": {
            "properties": {
              "ends": {
                "minItems": 2
              }
            }
          },
          "else": {
            "properties": {
              "ends": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "equipment": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "type"
      ],
      "additionalProperties": false
    },
    "state": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "name": {
      "type": "object",
      "properties": {
        "language": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "language",
        "value"
      ],
      "additionalProperties": false
    }
  }
}
