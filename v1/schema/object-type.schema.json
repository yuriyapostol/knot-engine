{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yuriyapostol.github.io/knot-engine/v1/schema/object-type.schema.json",
  "$ref": "#/$defs/objectType",
  "$defs": {
    "objectType": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "dataSchema": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "ref": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "ref"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "inline": {
                  "type": "object"
                }
              },
              "required": [
                "inline"
              ],
              "additionalProperties": false
            }
          ]
        },
        "specification": {
          "type": "string",
          "minLength": 1
        },
        "names": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/name"
          },
          "maxItems": 128
        },
        "descriptions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/name"
          },
          "maxItems": 128
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "dataSchema",
        "specification"
      ],
      "additionalProperties": false
    },
    "name": {
      "type": "object",
      "properties": {
        "language": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "language",
        "value"
      ],
      "additionalProperties": false
    }
  }
}
