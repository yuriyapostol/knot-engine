{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yuriyapostol.github.io/knot-engine/v1/schema/contribution.schema.json",
  "$ref": "#/$defs/contribution",
  "$defs": {
    "contribution": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "email": {
          "type": "string",
          "pattern": "^[^@\\s]+@[^@\\s]+$"
        },
        "url": {
          "type": "string",
          "pattern": "^https?://[^\\s]+$"
        },
        "roles": {
          "type": "array",
          "items": {
            "enum": [
              "creation",
              "import",
              "conversion",
              "editing",
              "validation"
            ]
          },
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true
        },
        "date": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    }
  }
}
