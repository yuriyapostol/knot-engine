{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yuriyapostol.github.io/knot-engine/v1/schema/3d.schema.json",
  "$ref": "#/$defs/geometry3d",
  "$defs": {
    "geometry3d": {
      "type": "object",
      "properties": {
        "coordinateSystem": {
          "type": "object",
          "properties": {
            "handedness": {
              "const": "right"
            },
            "upAxis": {
              "const": "y"
            },
            "scale": {
              "$ref": "#/$defs/scale"
            }
          },
          "required": [
            "handedness",
            "upAxis",
            "scale"
          ],
          "additionalProperties": false
        },
        "elements": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/curve3"
              },
              {
                "$ref": "#/$defs/mesh3"
              }
            ]
          },
          "minItems": 1,
          "maxItems": 256
        }
      },
      "required": [
        "coordinateSystem",
        "elements"
      ],
      "additionalProperties": false
    },
    "scale": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "relative"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "physical"
            },
            "metersPerUnit": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "kind",
            "metersPerUnit"
          ],
          "additionalProperties": false
        }
      ]
    },
    "curve3": {
      "oneOf": [
        {
          "$ref": "#/$defs/interpolatedCurve3"
        },
        {
          "$ref": "#/$defs/segmentedCurve3"
        }
      ]
    },
    "interpolatedCurve3": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "curve"
        },
        "object": {
          "type": "string",
          "minLength": 1
        },
        "closed": {
          "type": "boolean"
        },
        "interpolation": {
          "$ref": "#/$defs/interpolation"
        },
        "points": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/point3"
          },
          "minItems": 2,
          "maxItems": 4096
        }
      },
      "required": [
        "id",
        "type",
        "closed",
        "interpolation",
        "points"
      ],
      "additionalProperties": false
    },
    "interpolation": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "polyline"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "catmull-rom"
            },
            "parameterization": {
              "const": "uniform"
            },
            "tension": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            }
          },
          "required": [
            "type",
            "parameterization",
            "tension"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "catmull-rom"
            },
            "parameterization": {
              "enum": [
                "centripetal",
                "chordal"
              ]
            }
          },
          "required": [
            "type",
            "parameterization"
          ],
          "additionalProperties": false
        }
      ]
    },
    "point3": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "segmentedCurve3": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "curve"
        },
        "object": {
          "type": "string",
          "minLength": 1
        },
        "closed": {
          "type": "boolean"
        },
        "start": {
          "$ref": "#/$defs/point3"
        },
        "segments": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/curveSegment3"
          }
        }
      },
      "required": [
        "id",
        "type",
        "closed",
        "start",
        "segments"
      ],
      "additionalProperties": false
    },
    "curveSegment3": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "line"
            },
            "end": {
              "$ref": "#/$defs/point3"
            }
          },
          "required": [
            "type",
            "end"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "quadratic"
            },
            "control": {
              "$ref": "#/$defs/point3"
            },
            "end": {
              "$ref": "#/$defs/point3"
            }
          },
          "required": [
            "type",
            "control",
            "end"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "cubic"
            },
            "control1": {
              "$ref": "#/$defs/point3"
            },
            "control2": {
              "$ref": "#/$defs/point3"
            },
            "end": {
              "$ref": "#/$defs/point3"
            }
          },
          "required": [
            "type",
            "control1",
            "control2",
            "end"
          ],
          "additionalProperties": false
        }
      ]
    },
    "mesh3": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "mesh"
        },
        "object": {
          "type": "string",
          "minLength": 1
        },
        "vertices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/point3"
          },
          "minItems": 3
        },
        "faces": {
          "type": "array",
          "items": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          },
          "minItems": 1
        }
      },
      "required": [
        "id",
        "type",
        "vertices",
        "faces"
      ],
      "additionalProperties": false
    }
  }
}
