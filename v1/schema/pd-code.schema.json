{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yuriyapostol.github.io/knot-engine/v1/schema/pd-code.schema.json",
  "$ref": "#/$defs/pd",
  "$defs": {
    "pd": {
      "type": "object",
      "properties": {
        "convention": {
          "const": "https://yuriyapostol.github.io/knot-engine/v1/conventions/pd-ccw-under-first"
        },
        "crossings": {
          "type": "array",
          "maxItems": 16384,
          "items": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "minItems": 4,
            "maxItems": 4
          }
        },
        "unlinkedComponents": {
          "type": "integer",
          "minimum": 0,
          "maximum": 16384
        }
      },
      "required": [
        "convention",
        "crossings"
      ],
      "additionalProperties": false
    }
  }
}
