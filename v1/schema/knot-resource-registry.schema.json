{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yuriyapostol.github.io/knot-engine/v1/schema/knot-resource-registry.schema.json",
  "$ref": "#/$defs/registry",
  "$defs": {
    "registry": {
      "type": "object",
      "properties": {
        "schema": {
          "const": "KnotResourceRegistry"
        },
        "schemaVersion": {
          "const": 1
        },
        "$schema": {
          "type": "string",
          "minLength": 1
        },
        "namespaces": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z][A-Za-z0-9_-]*$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "resources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/resource"
          },
          "minItems": 0,
          "maxItems": 2048
        }
      },
      "required": [
        "schema",
        "schemaVersion",
        "resources"
      ],
      "additionalProperties": false
    },
    "resource": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "catalog"
            },
            "resource": {
              "$ref": "#/$defs/catalog"
            }
          },
          "required": [
            "kind",
            "resource"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "representation-type"
            },
            "resource": {
              "$ref": "#/$defs/representationType"
            }
          },
          "required": [
            "kind",
            "resource"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "object-type"
            },
            "resource": {
              "$ref": "#/$defs/objectType"
            }
          },
          "required": [
            "kind",
            "resource"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "view"
            },
            "resource": {
              "$ref": "#/$defs/view"
            }
          },
          "required": [
            "kind",
            "resource"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "construction"
            },
            "resource": {
              "$ref": "#/$defs/construction"
            }
          },
          "required": [
            "kind",
            "resource"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "source"
            },
            "resource": {
              "$ref": "#/$defs/sourceDefinition"
            }
          },
          "required": [
            "kind",
            "resource"
          ],
          "additionalProperties": false
        }
      ]
    },
    "catalog": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "homepage": {
          "type": "string",
          "minLength": 1
        },
        "edition": {
          "type": "string",
          "minLength": 1
        },
        "identifierRules": {
          "type": "object",
          "properties": {
            "caseSensitive": {
              "type": "boolean"
            },
            "pattern": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [],
          "additionalProperties": false
        }
      },
      "required": [
        "id",
        "name",
        "description"
      ],
      "additionalProperties": false
    },
    "representationType": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "dataSchema": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "ref": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "ref"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "inline": {
                  "type": "object"
                }
              },
              "required": [
                "inline"
              ],
              "additionalProperties": false
            }
          ]
        },
        "specification": {
          "type": "string",
          "minLength": 1
        },
        "viewSpace": {
          "enum": [
            "none",
            "plane",
            "space"
          ]
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "dataSchema",
        "specification"
      ],
      "additionalProperties": false
    },
    "objectType": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "dataSchema": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "ref": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "ref"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "inline": {
                  "type": "object"
                }
              },
              "required": [
                "inline"
              ],
              "additionalProperties": false
            }
          ]
        },
        "specification": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "name",
        "description",
        "dataSchema",
        "specification"
      ],
      "additionalProperties": false
    },
    "view": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "space": {
              "const": "space"
            },
            "camera": {
              "$ref": "#/$defs/camera3"
            }
          },
          "required": [
            "id",
            "name",
            "space",
            "camera"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "name": {
              "type": "string",
              "minLength": 1
            },
            "description": {
              "type": "string",
              "minLength": 1
            },
            "space": {
              "const": "plane"
            },
            "camera": {
              "type": "object",
              "properties": {
                "mode": {
                  "const": "plane"
                },
                "center": {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 2,
                  "maxItems": 2
                },
                "height": {
                  "type": "number",
                  "exclusiveMinimum": 0
                }
              },
              "required": [
                "mode",
                "center",
                "height"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "id",
            "name",
            "space",
            "camera"
          ],
          "additionalProperties": false
        }
      ]
    },
    "camera3": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "fit"
            },
            "direction": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "up": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "projection": {
              "$ref": "#/$defs/projection"
            },
            "padding": {
              "type": "number",
              "minimum": 1
            }
          },
          "required": [
            "mode",
            "direction",
            "up",
            "projection"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "fixed"
            },
            "position": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "target": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "up": {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 3,
              "maxItems": 3
            },
            "projection": {
              "$ref": "#/$defs/fixedProjection"
            }
          },
          "required": [
            "mode",
            "position",
            "target",
            "up",
            "projection"
          ],
          "additionalProperties": false
        }
      ]
    },
    "projection": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "perspective"
            },
            "fovY": {
              "type": "number",
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 3.141592653589793
            }
          },
          "required": [
            "kind",
            "fovY"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "orthographic"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        }
      ]
    },
    "fixedProjection": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "perspective"
            },
            "fovY": {
              "type": "number",
              "exclusiveMinimum": 0,
              "exclusiveMaximum": 3.141592653589793
            }
          },
          "required": [
            "kind",
            "fovY"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "orthographic"
            },
            "height": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "kind",
            "height"
          ],
          "additionalProperties": false
        }
      ]
    },
    "construction": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "objects": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/object"
          },
          "minItems": 1,
          "maxItems": 256
        },
        "states": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/state"
          },
          "minItems": 0,
          "maxItems": 256
        }
      },
      "required": [
        "id",
        "objects"
      ],
      "additionalProperties": false
    },
    "object": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "type"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "https://yuriyapostol.github.io/knot-engine/v1/object-types/rope"
              }
            }
          },
          "then": {
            "$ref": "#/$defs/rope"
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "https://yuriyapostol.github.io/knot-engine/v1/object-types/support",
                  "https://yuriyapostol.github.io/knot-engine/v1/object-types/carabiner"
                ]
              }
            }
          },
          "then": {
            "$ref": "#/$defs/equipment"
          }
        }
      ]
    },
    "rope": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "topology": {
          "enum": [
            "open",
            "closed"
          ]
        },
        "ends": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id"
            ],
            "additionalProperties": false
          },
          "minItems": 0,
          "maxItems": 2
        },
        "length": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "diameter": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "id",
        "type",
        "topology",
        "ends"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "topology": {
                "const": "open"
              }
            }
          },
          "then": {
            "properties": {
              "ends": {
                "minItems": 2
              }
            }
          },
          "else": {
            "properties": {
              "ends": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "equipment": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "type"
      ],
      "additionalProperties": false
    },
    "state": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false
    },
    "sourceDefinition": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "url": {
          "type": "string",
          "pattern": "^https?://[^\\s]+$"
        },
        "authors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceAuthor"
          },
          "maxItems": 128,
          "minItems": 1
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "license": {
          "$ref": "#/$defs/license"
        },
        "locator": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "accessed": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "note": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "id"
      ],
      "additionalProperties": false,
      "anyOf": [
        {
          "required": [
            "title"
          ]
        },
        {
          "required": [
            "url"
          ]
        }
      ]
    },
    "sourceAuthor": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "email": {
          "type": "string",
          "pattern": "^[^@\\s]+@[^@\\s]+$"
        },
        "url": {
          "type": "string",
          "pattern": "^https?://[^\\s]+$"
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "license": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "url": {
          "type": "string",
          "pattern": "^https?://[^\\s]+$"
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    }
  }
}
