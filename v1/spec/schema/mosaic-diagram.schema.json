{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yuriyapostol.github.io/knot-engine/v1/schema/mosaic-diagram.schema.json",
  "$ref": "#/$defs/mosaic",
  "$defs": {
    "mosaic": {
      "type": "object",
      "properties": {
        "tileSet": {
          "const": "https://yuriyapostol.github.io/knot-engine/v1/tile-sets/lomonaco-kauffman-11"
        },
        "tiles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10
            }
          }
        }
      },
      "required": [
        "tileSet",
        "tiles"
      ],
      "additionalProperties": false
    }
  }
}
