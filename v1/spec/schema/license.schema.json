{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yuriyapostol.github.io/knot-engine/v1/schema/license.schema.json",
  "$ref": "#/$defs/license",
  "$defs": {
    "license": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "url": {
          "type": "string",
          "pattern": "^https?://[^\\s]+$"
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    }
  }
}
