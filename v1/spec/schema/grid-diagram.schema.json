{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yuriyapostol.github.io/knot-engine/v1/schema/grid-diagram.schema.json",
  "$ref": "#/$defs/grid",
  "$defs": {
    "grid": {
      "oneOf": [
        {
          "$ref": "#/$defs/gridXO"
        },
        {
          "$ref": "#/$defs/gridVertexPairs"
        }
      ]
    },
    "gridXO": {
      "type": "object",
      "properties": {
        "encoding": {
          "const": "xo"
        },
        "size": {
          "type": "integer",
          "minimum": 2,
          "maximum": 512
        },
        "x": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 2,
          "maxItems": 512
        },
        "o": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          },
          "minItems": 2,
          "maxItems": 512
        }
      },
      "required": [
        "encoding",
        "size",
        "x",
        "o"
      ],
      "additionalProperties": false
    },
    "gridVertexPairs": {
      "type": "object",
      "properties": {
        "encoding": {
          "const": "vertex-pairs"
        },
        "size": {
          "type": "integer",
          "minimum": 2,
          "maximum": 512
        },
        "vertices": {
          "type": "array",
          "minItems": 4,
          "maxItems": 1024,
          "uniqueItems": true,
          "items": {
            "type": "array",
            "prefixItems": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "integer",
                "minimum": 0
              }
            ],
            "items": false,
            "minItems": 2,
            "maxItems": 2
          }
        }
      },
      "required": [
        "encoding",
        "size",
        "vertices"
      ],
      "additionalProperties": false
    }
  }
}
