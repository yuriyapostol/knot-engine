              "language": "uk",
              "value": "Просте кільце"
            }
          ],
          "instructions": [
            {
              "language": "en",
              "value": "Lay out the closed rope as a flat ring."
            },
            {
              "language": "uk",
              "value": "Розкладіть замкнену мотузку у плоске кільце."
            }
          ]
        },
        {
          "id": "twist",
          "representations": [
            {
              "id": "view-3d-twist"
            }
          ],
          "names": [
            {
              "language": "en",
              "value": "Partial twist"
            },
            {
              "language": "uk",
              "value": "Часткове скручування"
            }
          ],
          "instructions": [
            {
              "language": "en",
              "value": "Hold the left side and turn the right side of the ring by a quarter turn out of its plane."
            },
            {
              "language": "uk",
              "value": "Утримуючи лівий бік, поверніть правий бік кільця на чверть оберту з його площини."
            }
          ]
        },
        {
          "id": "finish",
          "representations": [
            {
              "id": "view-3d-finish"
            }
          ],
          "names": [
            {
              "language": "en",
              "value": "Twisted loop"
            },
            {
              "language": "uk",
              "value": "Скручена петля"
            }
          ],
          "instructions": [
            {
              "language": "en",
              "value": "Continue turning the right side by another quarter turn to form a crossing, keeping one strand above the other."
            },
            {
              "language": "uk",
              "value": "Продовжте поворот правого боку ще на чверть оберту, утворюючи перехрещення та залишаючи одну гілку над іншою."
            }
          ]
        }
      ],
      "names": [
        {
          "language": "en",
          "value": "Twisting the loop step by step"
        },
        {
          "language": "uk",
          "value": "Послідовне скручування петлі"
        }
      ],
      "descriptions": [
        {
          "language": "en",
          "value": "Three steps from a flat ring through a partial twist to the finished loop."
        },
        {
          "language": "uk",
          "value": "Три кроки від плоского кільця через часткове скручування до готової петлі."
        }
