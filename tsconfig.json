{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "declaration": true,
    "jsx": "preserve",
    "types": [
      "vite/client",
      "vitest/globals",
      "node"
    ],
    "resolveJsonModule": true,
    "paths": {
      "knot-engine": [
        "./src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "tests",
    "vite.config.ts",
    "site"
  ]
}
