{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://knot-viewer.local/schema/knot-model-v1.schema.json",
  "title": "KnotModelV1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "coordinateSystem", "units", "curves"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "minLength": 1, "maxLength": 256 },
    "coordinateSystem": { "const": "right-handed-y-up" },
    "units": { "const": "relative" },
    "curves": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "$ref": "#/$defs/curve" } },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "preset": { "const": "light-outline-v1" },
        "cameraPosition": { "$ref": "#/$defs/point" },
        "target": { "$ref": "#/$defs/point" },
        "fov": { "type": "number", "minimum": 10, "maximum": 100 }
      },
      "dependentRequired": { "cameraPosition": ["target"], "target": ["cameraPosition"] }
    }
  },
  "$defs": {
    "point": {
      "description": "Coordinates [x, y, z]",
      "type": "array", "minItems": 3, "maxItems": 3,
      "items": { "type": "number", "minimum": -100000, "maximum": 100000 }
    },
    "curve": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "closed", "interpolation", "radius", "points"],
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "closed": { "type": "boolean" },
        "interpolation": {
          "type": "object", "additionalProperties": false,
          "required": ["type", "tension"],
          "properties": {
            "type": { "const": "catmullrom" },
            "tension": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        },
        "radius": { "type": "number", "exclusiveMinimum": 0, "maximum": 10000 },
        "points": { "type": "array", "minItems": 2, "maxItems": 512, "items": { "$ref": "#/$defs/point" } }
      }
    }
  }
}
