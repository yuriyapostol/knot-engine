{
  "name": "knot-engine",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "files": [
    "dist",
    "v1",
    "README.md",
    "README.uk.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./styles.css": "./dist/style.css",
    "./schema/knot-asset.schema.json": "./v1/schema/knot-asset.schema.json",
    "./schema/*": "./v1/schema/*"
  },
  "scripts": {
    "build": "vue-tsc --noEmit && vite build && vue-tsc -p tsconfig.build.json",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "preview:model": "node scripts/preview/index.mjs",
    "test:browser": "node scripts/test-browser.mjs",
    "test:package": "node scripts/test-package.mjs",
    "build:site": "node scripts/site/build.mjs",
    "site:archive": "node scripts/site/archive.mjs",
    "test:site": "node scripts/site/test.mjs",
    "preview:site": "npm run build:site && vite preview --config site/vite.config.ts",
    "build:example": "vite build --config site/runtime/vite.config.ts",
    "dev": "node scripts/site/dev.mjs",
    "build:schemas": "node scripts/generate-schemas.mjs"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "three": "^0.186.1",
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "jsdom": "^26.1.0",
    "marked": "^18.1.1",
    "playwright-core": "^1.63.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^3.2.4",
    "vue": "^3.5.43",
    "vue-tsc": "^3.1.0"
  },
  "knotEngine": {
    "resourceDirectory": "v1"
  }
}
