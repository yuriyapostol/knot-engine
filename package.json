{
  "name": "knot-viewer",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "files": [
    "dist",
    "schema",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./styles.css": "./dist/style.css",
    "./schema/knot-model-v1.schema.json": "./schema/knot-model-v1.schema.json"
  },
  "scripts": {
    "dev:demo": "vite --config demo/vite.config.ts",
    "build": "vue-tsc --noEmit && vite build && vue-tsc -p tsconfig.build.json",
    "build:demo": "vite build --config demo/vite.config.ts",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "preview:model": "node scripts/preview/index.mjs"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "dependencies": {
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "jsdom": "^26.1.0",
    "playwright-core": "^1.63.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vitest": "^3.2.4",
    "vue": "^3.5.43",
    "vue-tsc": "^3.1.0"
  }
}
